server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Web-Server $hostname always;

    location = /lb-test {
        default_type text/plain;
        return 200 "Web Server: $hostname\n";
    }
    location / {
        try_files $uri $uri/ =404;
    }
}