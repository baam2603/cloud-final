  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location / { try_files $uri $uri/ =404; }
  
  location ^~ /blog/ {
    alias /usr/share/nginx/html/blog/;
    index index.html;
    autoindex off;
  }

  # Trả về một metric hợp lệ để Prometheus nhận diện là UP
  location = /metrics {
    default_type text/plain;
    access_log off;
    return 200 "nginx_up 1\n";
