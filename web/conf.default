server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Header và endpoint dành cho test Load Balancer (từ nhánh HEAD)
    add_header X-Web-Server $hostname always;

    location = /lb-test {
        default_type text/plain;
        return 200 "Web Server: $hostname\n";
    }

    # Cấu hình đường dẫn cho thư mục Blog (từ nhánh origin/main)
    location ^~ /blog/ {
        alias /usr/share/nginx/html/blog/;
        index index.html;
        autoindex off;
    }

    # Endpoint cung cấp metric cho Prometheus (từ nhánh origin/main)
    location = /metrics {
        default_type text/plain;
        access_log off;
        return 200 "nginx_up 1\n";
    }

    # Cấu hình router mặc định cho file tĩnh
    location / {
        try_files $uri $uri/ =404;
    }
}